    public static Power assignPower(int lineNum) {

        try (BufferedReader br = new BufferedReader(new FileReader("choices/Powers.txt"))) {

            String line;
            int currentLine = 1;

            while ((line = br.readLine()) != null) {

                if (currentLine == lineNum) {

                    String[] parts = line.split(",");

                    String name = parts[0];
                    boolean social = Boolean.parseBoolean(parts[1]);
                    int efficacy = Integer.parseInt(parts[2]);

                    return new Power(name, social, efficacy);
                }

                currentLine++;
            }
        }
        catch (Exception e) {
            e.printStackTrace();
        }

        return null;
    }
    public static Superhero assignHero(int lineNum) {

        try (BufferedReader br = new BufferedReader(new FileReader("choices/Supers.txt"))) {

            String line;
            int currentLine = 1;

            while ((line = br.readLine()) != null) {

                if (currentLine == lineNum) {

                    String[] parts = line.split(",");

                    String powerName = parts[0];
                    Boolean powerSocial = Boolean.valueOf(parts[1]);
                    int powerEfficacy = Integer.parseInt(parts[2]);
                    String heroName = parts[3];
                    String weakness1 = parts[4];
                    String weakness2 = parts[5];
                    int strength = Integer.parseInt(parts[6]);
                    int stamina = Integer.parseInt(parts[7]);
                    int intelligence = Integer.parseInt(parts[8]);
                    int health = Integer.parseInt(parts[9]); 
                    Power power = new Power(powerName, powerSocial, powerEfficacy);
                    return new Superhero(power, heroName, weakness1, weakness2, strength, stamina, intelligence, health);
                }

                currentLine++;
            }
        }
        catch (Exception e) {
            e.printStackTrace();
        }

        return null;
    }
    public static void getHeroStatus(){
        try(BufferedReader br = new BufferedReader(new FileReader("choices/superheroHealth.txt"))){
            String line;
            while ((line = br.readLine()) != null){
                if(Integer.parseInt(line) >= 350){
                    System.out.println("Congratulations! You are a very well qualified superhero!");
                }
            }
        }
        catch(Exception e){
            e.printStackTrace();
        }
    }
