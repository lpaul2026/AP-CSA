class Superhero{
    private Power power;
    private String name;
    private String weakness1;
    private String weakness2;
    private int strength;
    private int stamina;
    private int intelligence;
    private boolean sidekick;
    
    public Superhero(Power inPower, String inName, String inWeakness1, String inWeakness2, int inStrength, int inStamina, int inIntelligence){
        power = inPower;
        name = inName;
        weakness1 = inWeakness1;
        weakness2 = inWeakness2;
        strength = inStrength;
        stamina = inStamina;
        intelligence = inIntelligence;
    }
    
    //public Power GetPower(){
    //  String result = power.GetEfficacy() + power.GetName() + power.GetEfficacy();
    //  return result;
    //}
    
    public String GetName(){
        return name;
    }
    
    public String GetWeakness1(){
        return weakness1;
    }
    
    public String GetWeakness2(){
        return weakness2;
    }
    
    public int GetStrength(){
        return strength;
    }
    
    public int GetStamina(){
        return stamina;
    }
    
    public int GetIntelligence(){
        return intelligence;
    }
    
    public boolean SidekickRequired(){
        if(power.GetSocial() == true){
            sidekick = true;
        }
        else{
            sidekick = false;
        }
        return sidekick;    
    }
    public String toString(){
        String result = "";
        result = name + " is Novus Vetus City's superhero. Their power is " + power.GetName() + ". Their strength, stamina, and intelligence levels are "
        + strength + ", " + stamina + ", " + intelligence + " respectively. Their weaknesses are " + weakness1 + " and " + weakness2;
    return result;
    }
}



class Power{
    private boolean social;
    private int efficacyRate;
    private String name;
    public Power(String inName, boolean inSocial, int inEfficacyRate){
        name = inName;
        social = inSocial;
        efficacyRate = inEfficacyRate;
    }
    public String GetName(){
        return name;
    }
    public boolean GetSocial(){
        return social;
    }
    public int GetEfficacy(){
        return efficacyRate;
    }
}
