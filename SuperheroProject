import java.util.*;
import java.io.*;

public class Test {

    static Scanner scan = new Scanner(System.in);

    public static void main(String[] args) {

        Power strength = new Power("Super Strength", false, 70);
        Power flight = new Power("Flight", true, 65);
        Power invisibility = new Power("Invisibility", false, 85);
        Power smart = new Power("Super Intelligence", false, 90);
        Power animalComms = new Power("Animal Communication", true, 75);

        Superhero behemoth = new Superhero(strength, "Benevolent Behemoth", "Cheese", "Heights", 80, 150, 40, 120);
        Superhero canary = new Superhero(flight, "Crimefighting Canary", "Water", "Animals", 50, 75, 80, 100);
        Superhero phasr = new Superhero(invisibility, "Phasr", "Ego", "Papaya", 30, 80, 90, 90);
        Superhero cyfer = new Superhero(smart,"Cyfer","Pollen","Running",40,50,150,85);
        Superhero leopard = new Superhero(animalComms,"Leopard Linguist","People","Darkness",70,55,80,95);

        //choosing the hero
        System.out.println("=================================");
        System.out.println("City Defenders");
        System.out.println("=================================");

        System.out.println("\nChoose your superhero:\n");
        System.out.println("1. " + behemoth.GetName());
        System.out.println("2. " + canary.GetName());
        System.out.println("3. " + phasr.GetName());
        System.out.println("4. " + cyfer.GetName());
        System.out.println("5. " + leopard.GetName());

        int choice = scan.nextInt();

        Superhero player = null;

        switch (choice) {

            case 1:
                player = behemoth;
                break;

            case 2:
                player = canary;
                break;

            case 3:
                player = phasr;
                break;

            case 4:
                player = cyfer;
                break;

            case 5:
                player = leopard;
                break;

            default:
                System.out.println("Invalid choice.");
                System.exit(0);
        }

        saveHeroName(player.GetName());

        System.out.println("\nYou selected:");
        System.out.println(player);

        // MISSIONS
        Mission mission1 = new Mission("Bank Robbery",180,20);
        Mission mission2 = new Mission("Rescue the Mayor",200,25);
        Mission mission3 = new Mission("Stop the Train Crash",230,30);
        Mission mission4 = new Mission("Defeat the Giant Robot",260,35);
        Mission mission5 = new Mission("Save the City Power Grid",280,40);

        playMission(player, mission1);
        playMission(player, mission2);
        playMission(player, mission3);
        playMission(player, mission4);
        playMission(player, mission5);

        // FINAL BOSS
        Villain finalBoss = new Villain("Doctor Oblivion",350);

        System.out.println("\n=================================");
        System.out.println(" FINAL BATTLE");
        System.out.println("=================================");

        System.out.println("\nThe evil " + finalBoss.GetName() + " appears!");

        int heroPower = player.GetStrength() + player.GetStamina() + player.GetIntelligence() + player.GetExperience();

        System.out.println("\nYour total power: " + heroPower);
        System.out.println(finalBoss.GetName() + "'s power: " + finalBoss.GetPowerLevel());

        if (heroPower >= finalBoss.GetPowerLevel()) {
            System.out.println("\nYOU SAVED THE CITY!");
            System.out.println("YOU WIN!");

        } else {
            System.out.println("\nYou fought bravely...");
            System.out.println("BUT THE CITY HAS FALLEN.");
        }
        saveHeroStatus(player.GetName(), player.GetHealth());
        getHeroStatus();
    }

    // SAVE HERO TO FILE
    public static void saveHeroName(String heroName) {
        try {
            File folder = new File("choices");
            if (!folder.exists()) {
                folder.mkdir();
            }
            BufferedWriter writer = new BufferedWriter(new FileWriter("choices/superheroName.txt"));
            writer.write(heroName);
            writer.close();
            System.out.println("\nHero saved successfully.");
        } catch (IOException e) {
            System.out.println("Error saving hero.");
        }
    }   
    public static void saveHeroStatus(String heroName, int health) {
        try {
            File folder = new File("choices");
            if (!folder.exists()) {
                folder.mkdir();
            }
            BufferedWriter writer = new BufferedWriter(new FileWriter("choices/superheroHealth.txt"));
            writer.write(String.valueOf(health));
            writer.close();
            System.out.println("\nHero saved successfully.");
        } catch (IOException e) {
            System.out.println("Error saving hero.");
        }
    }

    // =========================
    // PLAY MISSION
    // =========================
    public static void playMission(Superhero hero,Mission mission) {
        System.out.println("\n=================================");
        System.out.println("MISSION: " + mission.GetMissionName());
        System.out.println("=================================");
        System.out.println("\n1. Use aggression and physical force");
        System.out.println("2. Use sneaking powers");
        System.out.println("3. Create a device that remotely completes the task");
        System.out.println("4. Converse with your animal friends");
        System.out.println("5. Intercept the perpetrator from a high point");
        int choice = scan.nextInt();
        int heroPower = hero.GetStrength() + hero.GetStamina() + hero.GetIntelligence();
        // strategy bonus
        if(choice == 1) {
            if(hero.GetStrength() >= 80){
                heroPower += 20;
            }
            else if(hero.GetStrength() <= 40){
                heroPower -= 20;
            }
        }
        else if(choice == 2){
            if(hero.GetIntelligence() >= 80){
                heroPower += 20;
            }
            else if(hero.GetIntelligence() <= 40){
                heroPower -= 20;
            }
        }
        else if(choice == 3){
            if(hero.GetIntelligence() >= 40){
                heroPower += 20;
            }
            if(hero.GetWeakness1().equals("Darkness") || hero.GetWeakness2().equals("Darkness")){
                hero.TakeDamage(50);
                System.out.println("Uh Oh. You picked an option that is related to your weakness! Your health goes down significantly.");
            }
        }
        else if(choice == 4){
            if(hero.GetName().equals("Leopard Linguist")){
                heroPower += 20;
            }
            if(hero.GetWeakness1().equals("Animals") || hero.GetWeakness2().equals("Animals")){
                hero.TakeDamage(50);
                System.out.println("Uh Oh. You picked an option that is related to your weakness! Your health goes down significantly.");
            }
        }
        else if(choice == 5){
            if(hero.GetName().equals("Crimefighting Canary")){
                heroPower += 20;
            }
            if(hero.GetWeakness1().equals("Heights") || hero.GetWeakness2().equals("Heights")){
                hero.TakeDamage(50);
                System.out.println("Uh Oh. You picked an option that is related to your weakness! Your health goes down significantly.");
            }
        }
        if (heroPower >= mission.GetDifficulty()) {
            System.out.println("\nMISSION SUCCESSFUL!");
            hero.AddExperience(mission.GetRewardXP());
            System.out.println("Gained " + mission.GetRewardXP() + " XP!");
        }
        else {
            System.out.println("\nMISSION FAILED!");
            hero.TakeDamage(15);
            System.out.println("You lost 15 health.");
        }

        System.out.println("Current Health: " + hero.GetHealth());

        System.out.println("Current XP: " + hero.GetExperience());
        saveHeroStatus(hero.GetName(), hero.GetHealth());
    }
    public static void getHeroStatus(){
        try(BufferedReader br = new BufferedReader(new FileReader("choices/superheroHealth.txt"))){
            String line;
            while ((line = br.readLine()) != null){
                if(Integer.parseInt(line) >= 50){
                    System.out.println("Congratulations! You are a very well qualified superhero!");
                }
            }
        }
        catch(Exception e){
            e.printStackTrace();
        }
    }
}
class Superhero {
    private Power power;
    private String name;
    private String weakness1;
    private String weakness2;
    private int strength;
    private int stamina;
    private int intelligence;
    private int health;
    private int experience;
    public Superhero(Power inPower, String inName, String inWeakness1, String inWeakness2, int inStrength, int inStamina, int inIntelligence, int inHealth) {
        power = inPower;
        name = inName;
        weakness1 = inWeakness1;
        weakness2 = inWeakness2;
        strength = inStrength;
        stamina = inStamina;
        intelligence = inIntelligence;
        health = inHealth;
        experience = 0;
    }
    public String GetName() {
        return name;
    }
    public String GetWeakness1() {
        return weakness1;
    }
    public String GetWeakness2() {
        return weakness2;
    }
    public int GetStrength() {
        return strength;
    }
    public int GetStamina() {
        return stamina;
    }
    public int GetIntelligence() {
        return intelligence;
    }
    public int GetHealth() {
        return health;
    }
    public int GetExperience() {
        return experience;
    }
    public void AddExperience(int xp) {
        experience += xp;
    }
    public void TakeDamage(int damage) {
        health -= damage;
    }
    public String toString() {
        return "\n" + name + "\nPower: " + power.GetName() + "\nStrength: " + strength + "\nStamina: " + stamina + "\nIntelligence: " + intelligence + "\nWeaknesses: " + weakness1 + ", " + weakness2;
    }
}
// POWER CLASS
class Power {
    private String name;
    private boolean social;
    private int efficacyRate;
    public Power(String inName, boolean inSocial, int inEfficacyRate) {
        name = inName;
        social = inSocial;
        efficacyRate = inEfficacyRate;
    }
    public String GetName() {
        return name;
    }
    public boolean GetSocial() {
        return social;
    }
    public int GetEfficacy() {
        return efficacyRate;
    }
}
// MISSION CLASS
class Mission {
    private String missionName;
    private int difficulty;
    private int rewardXP;
    public Mission(String inMissionName,int inDifficulty,int inRewardXP) {
        missionName = inMissionName;
        difficulty = inDifficulty;
        rewardXP = inRewardXP;
    }
    public String GetMissionName() {
        return missionName;
    }
    public int GetDifficulty() {
        return difficulty;
    }
    public int GetRewardXP() {
        return rewardXP;
    }
}

// VILLAIN CLASS

class Villain {
    private String name;
    private int powerLevel;
    public Villain(
            String inName,
            int inPowerLevel
    ) {
        name = inName;
        powerLevel = inPowerLevel;
    }
    public String GetName() {
        return name;
    }
    public int GetPowerLevel() {
        return powerLevel;
    }
}
