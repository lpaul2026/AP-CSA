class Superhero {
    private Power power;
    private String name;
    private String weakness1;
    private String weakness2;
    private int strength;
    private int stamina;
    private int intelligence;
    private int health;
    private int experience;
    public Superhero(Power inPower, String inName, String inWeakness1, String inWeakness2, int inStrength, int inStamina, int inIntelligence, int inHealth) {
        power = inPower;
        name = inName;
        weakness1 = inWeakness1;
        weakness2 = inWeakness2;
        strength = inStrength;
        stamina = inStamina;
        intelligence = inIntelligence;
        health = inHealth;
        experience = 0;
    }
    public String GetName() {
        return name;
    }
    public String GetWeakness1() {
        return weakness1;
    }
    public String GetWeakness2() {
        return weakness2;
    }
    public int GetStrength() {
        return strength;
    }
    public int GetStamina() {
        return stamina;
    }
    public int GetIntelligence() {
        return intelligence;
    }
    public int GetHealth() {
        return health;
    }
    public int GetExperience() {
        return experience;
    }
    public void AddExperience(int xp) {
        experience += xp;
    }
    public void TakeDamage(int damage) {
        health -= damage;
    }
    public String toString() {
        return "\n" + name + "\nPower: " + power.GetName() + "\nStrength: " + strength + "\nStamina: " + stamina + "\nIntelligence: " + intelligence + "\nWeaknesses: " + weakness1 + ", " + weakness2;
    }
}
// POWER CLASS
class Power {
    private String name;
    private boolean social;
    private int efficacyRate;
    public Power(){
        
    }
    public Power(String inName, boolean inSocial, int inEfficacyRate) {
        name = inName;
        social = inSocial;
        efficacyRate = inEfficacyRate;
    }
    public String GetName() {
        return name;
    }
    public boolean GetSocial() {
        return social;
    }
    public int GetEfficacy() {
        return efficacyRate;
    }
}
