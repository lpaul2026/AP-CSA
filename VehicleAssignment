// Interface for speed control
interface Speedometer {
    public void setSpeed(double inSpeed);
    public double getSpeed();
}

// Base Vehicle class
class Vehicle implements Speedometer {
    protected String brandName;
    protected double speed;
    protected int passengers;
    protected double cargoWeight;

    public Vehicle() {
        brandName = "";
        speed = 0.0;
        passengers = 0;
        cargoWeight = 0.0;
    }

    public Vehicle(String brand, double speed, int passengers, double cargo) {
        this.brandName = brand;
        this.speed = speed;
        this.passengers = passengers;
        this.cargoWeight = cargo;
    }

    public String getBrand() { return brandName; }
    public void setBrandName(String brand) { this.brandName = brand; }

    public double getSpeed() { return speed; }
    public void setSpeed(double speed) { this.speed = speed; }
// method to get how many passengers can be held
    public int getPassengers() { return passengers; }

   //method to set how many passengers can be held
    public void setPassengers(int passengers) {
        this.passengers = passengers;
    }

    public double getCargoWeight() { return cargoWeight; }
    public void setCargoWeight(double cargo) { this.cargoWeight = cargo; }

    public String toString() {
        return "Brand:\t\t" + brandName + "\n" +
               "Speed (mph):\t" + getSpeed() + "\n" +
               "Passengers:\t" + passengers + "\n" +
               "Cargo (lbs):\t" + cargoWeight + "\n";
    }
}

//Car class
class Car extends Vehicle {
    protected int wheels = 4;
    protected String color;
    protected boolean spoiler = false;
    protected boolean stereo = false;
    protected double mpg;

    public Car(String brand, double speed, int passengers, double cargo, double mpg, String color) {
        super(brand, speed, passengers, cargo);
        this.mpg = mpg;
        this.color = color;
    }

    public void setSpoiler(boolean spoiler) { this.spoiler = spoiler; }
    public void setStereo(boolean stereo) { this.stereo = stereo; }

    @Override
    public double getSpeed() {
        return spoiler ? super.getSpeed() + 20 : super.getSpeed();
    }

    public double getMPG() {
        return stereo ? mpg * 0.9 : mpg;
    }

    public String toString() {
        return super.toString() +
               "Color:\t\t" + color + "\n" +
               "MPG:\t\t" + getMPG() + "\n";
    }
}

//Electric Vehicle class that inherits from car and vehicle
