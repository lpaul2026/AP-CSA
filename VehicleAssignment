//Spaceship class that inherits from vehicle only
class Spaceship extends Vehicle {
    private boolean warpDrive;

    public Spaceship(String brand, double speed, int passengers, double cargo, boolean warpDrive) {
        super(brand, speed, passengers, cargo);
        this.warpDrive = warpDrive;
    }

    @Override
    public double getSpeed() {
        return warpDrive ? super.getSpeed() * 10 : super.getSpeed();
    }

    public String toString() {
        return super.toString() +
               "Type:\t\tSpaceship\n" +
               "Warp Drive:\t" + warpDrive + "\n";
    }
}

